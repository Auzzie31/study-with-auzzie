rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'createdAt']) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 254 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidStudyState(data, userId) {
      return data.keys().hasAll(['userId', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'completedSubtopics', 'notes', 'doubts', 'tests', 'updatedAt']) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('completedSubtopics' in data) || (data.completedSubtopics is string && data.completedSubtopics.size() <= 500000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000000)) &&
        (!('doubts' in data) || (data.doubts is string && data.doubts.size() <= 500000)) &&
        (!('tests' in data) || (data.tests is string && data.tests.size() <= 500000));
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /profile/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          isValidProfile(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          isValidProfile(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /studyData/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          isValidStudyState(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          isValidStudyState(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }
  }
}
